{
  "name": "roster",
  "version": "0.1.0",
  "private": false,
  "description": "AI workforce scheduling agent for shift-based SMBs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thereisjosh/roster.git"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "eval:schedule": "npx promptfoo@0.115.0 eval -c evals/schedule-generation.yaml",
    "eval:parsing": "npx promptfoo@0.115.0 eval -c evals/availability-parsing.yaml",
    "eval:preferences": "npx promptfoo@0.115.0 eval -c evals/preference-extraction.yaml",
    "eval:classification": "npx promptfoo@0.115.0 eval -c evals/classification.yaml",
    "eval:two-agent": "npx promptfoo@0.115.0 eval -c evals/two-agent-schedule-generation.yaml",
    "eval:schedule:claude": "npx promptfoo@0.115.0 eval -c evals/schedule-generation-claude.yaml",
    "eval:schedule:slots": "npx promptfoo@0.115.0 eval -c evals/schedule-generation-slots.yaml",
    "eval:schedule:shift-vs-slot": "npx promptfoo@0.115.0 eval -c evals/schedule-generation-shift-vs-slot.yaml",
    "eval:schedule:compressed": "npx promptfoo@0.115.0 eval -c evals/schedule-generation-compressed.yaml",
    "eval:schedule:compressed:debug": "npx promptfoo@0.115.0 eval -c evals/schedule-generation-compressed-debug.yaml",
    "eval:schedule:compressed:model-compare": "npx promptfoo@0.115.0 eval -c evals/schedule-generation-compressed-model-compare.yaml",
    "eval:preference-ceiling": "npx promptfoo@0.115.0 eval -c evals/preference-ceiling.yaml",
    "eval": "npm run eval:schedule; npm run eval:parsing; npm run eval:preferences; npm run eval:classification",
    "eval:ci": "npm run eval",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "db:seed": "npx tsx scripts/seed-example.ts",
    "eval:report": "npx tsx scripts/eval-summary.ts",
    "eval:full": "npm run eval; npm run eval:report"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/google": "^1.2.0",
    "@ai-sdk/openai": "^1.3.0",
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-sdk/client-ses": "^3.700.0",
    "@azure/identity": "^4.13.1",
    "@neondatabase/serverless": "^0.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^8.55.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "ai": "^4.3.0",
    "axios": "^1.15.2",
    "better-auth": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.38.0",
    "inngest": "^4.2.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pino": "^9.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.30.0",
    "jsdom": "^24.1.3",
    "pino-pretty": "^11.3.0",
    "promptfoo": "^0.110.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
